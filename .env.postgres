# ============================================================
# Rails-8-API-Authentication – environment variable reference
# Copy this file to .env and fill in values for local dev.
# Never commit .env to version control.
# ============================================================

# ── Rails core ───────────────────────────────────────────────
# Set to development | test | production
RAILS_ENV=production

# Log to STDOUT (required for Docker / Kamal log tailing)
RAILS_LOG_TO_STDOUT=true

# Port for local Puma. Thruster/Kamal ignores this in production.
PORT=4000

# Number of Puma threads per worker.
# Keep each ActiveRecord DB pool >= the maximum number of threads that may
# access that database concurrently. DB-specific pool values below fall back
# to RAILS_MAX_THREADS when not explicitly configured.
RAILS_MAX_THREADS=3

# Log verbosity: debug | info | warn | error | fatal
# RAILS_LOG_LEVEL=debug

# ── Production secrets ───────────────────────────────────────
# Required in production to decrypt config/credentials.yml.enc.
# In Kamal deployments this is sourced from .kamal/secrets.
# DO NOT set this in .env on a production server – use the secrets file.
# RAILS_MASTER_KEY=<contents of config/master.key>

# Secret key base used by Rails in production (required when RAILS_MASTER_KEY
# is not provided; the test matrix runner boots the app with RAILS_ENV=production).
SECRET_KEY_BASE=916992ad075207820a30b0f9bebf59a4f034e0a74edb7172d37dabaa563c93c77be01083bfde8d8e02017fa68ecb08108c36ed463cc7b602d260fcfeb4a892d8

# Explicit JWT signing key (optional – falls back to secret_key_base).
# Set this in production/staging so the key can be rotated independently
# of the Rails master key without invalidating all existing tokens.
# DEVISE_JWT_SECRET_KEY=<random 64-char hex string>

# ── Puma / concurrency ───────────────────────────────────────
# Number of Puma worker processes (multi-process mode). Default: 1.
# Increase only when running on a server with multiple CPU cores.
# WEB_CONCURRENCY=2

# Run Solid Queue inside the Puma process (set to true for single-server setups).
# SOLID_QUEUE_IN_PUMA=true

# Number of Solid Queue worker threads. Default: 1.
# JOB_CONCURRENCY=3

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection settings (see config/database.yml).
#
# Timeout units:
#   *_CONNECT_TIMEOUT   = seconds (integer)
#   *_CHECKOUT_TIMEOUT  = seconds (integer)
#   *_STATEMENT_TIMEOUT = PostgreSQL duration, e.g. 5000ms, 15s, 30s
#                          Use 0 only when you intentionally want no SQL timeout.
#
# Precedence is environment/database-specific. The defaults below mirror
# config/database.yml and can be overridden without changing application code.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rails_8_api_authentication_development
POSTGRES_TEST_DB=rails_8_api_authentication_test

# Backward-compatible fallback used only by production.primary when neither
# PRIMARY_DB_STATEMENT_TIMEOUT nor PRODUCTION_DB_STATEMENT_TIMEOUT is set.
# It is NOT a global timeout for development/test/cache/queue/cable.
# Keep this commented unless you specifically need the compatibility fallback.
POSTGRES_STATEMENT_TIMEOUT=15000ms

# ── Development database tuning ─────────────────────────────
# Defaults: pool=RAILS_MAX_THREADS, connect=5s, checkout=5s, statement=15s.
# Development is deliberately more relaxed than production for console work,
# debugging and local migrations. Uncomment only values you want to override.
# DEVELOPMENT_DB_POOL=3
# DEVELOPMENT_DB_CONNECT_TIMEOUT=5
# DEVELOPMENT_DB_CHECKOUT_TIMEOUT=5
# DEVELOPMENT_DB_STATEMENT_TIMEOUT=15000ms

# ── Test database tuning ────────────────────────────────────
# Defaults: pool=RAILS_MAX_THREADS, connect=5s, checkout=10s, statement=30s.
# Test/CI is allowed more time for schema setup, fixtures and integration tests.
# TEST_DB_POOL=3
# TEST_DB_CONNECT_TIMEOUT=5
# TEST_DB_CHECKOUT_TIMEOUT=10
# TEST_DB_STATEMENT_TIMEOUT=30000ms

# ── Production database URLs ────────────────────────────────
# REQUIRED when running RAILS_ENV=production.
# (e.g. scripts/test_ruby_versions.sh, which boots the app in production).
# config/initializers/production_database_urls.rb validates that all four exist
# and point to four DISTINCT databases. Note the test matrix runner drops and
# re-creates these databases on every Ruby version, so the DB user needs
# CREATEDB/DROPDB privileges.
#
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rails_8_api_authentication_production
# CACHE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rails_8_api_authentication_production_cache
# QUEUE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rails_8_api_authentication_production_queue
# CABLE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rails_8_api_authentication_production_cable

# ── Production shared tuning ────────────────────────────────
# These values are fallbacks shared by primary/cache/queue/cable.
# Per-database variables below take precedence over these shared values.
#
# Pool falls back to RAILS_MAX_THREADS if PRODUCTION_DB_POOL is unset.
# PRODUCTION_DB_POOL=3
# PRODUCTION_DB_CONNECT_TIMEOUT=5
# PRODUCTION_DB_CHECKOUT_TIMEOUT=5
#
# IMPORTANT: setting PRODUCTION_DB_STATEMENT_TIMEOUT overrides the individual
# defaults for ALL four production databases. Leaving it unset preserves:
#   primary=5s, cache=5s, queue=10s, cable=5s.
# PRODUCTION_DB_STATEMENT_TIMEOUT=5000ms

# ── Production: primary database overrides ──────────────────
# Default: pool=shared/RAILS_MAX_THREADS, connect=5s, checkout=5s, statement=5s.
# PRIMARY_DB_POOL=3
# PRIMARY_DB_CONNECT_TIMEOUT=5
# PRIMARY_DB_CHECKOUT_TIMEOUT=5
# PRIMARY_DB_STATEMENT_TIMEOUT=5000ms

# ── Production: Solid Cache database overrides ──────────────
# Default: pool=shared/RAILS_MAX_THREADS, connect=5s, checkout=5s, statement=5s.
# CACHE_DB_POOL=3
# CACHE_DB_CONNECT_TIMEOUT=5
# CACHE_DB_CHECKOUT_TIMEOUT=5
# CACHE_DB_STATEMENT_TIMEOUT=5000ms

# ── Production: Solid Queue database overrides ──────────────
# Queue gets a larger 10s SQL guardrail because maintenance/housekeeping work
# can legitimately be a little heavier than ordinary web/cache/cable queries.
# QUEUE_DB_POOL=3
# QUEUE_DB_CONNECT_TIMEOUT=5
# QUEUE_DB_CHECKOUT_TIMEOUT=5
# QUEUE_DB_STATEMENT_TIMEOUT=10000ms

# ── Production: Solid Cable database overrides ──────────────
# Default: pool=shared/RAILS_MAX_THREADS, connect=5s, checkout=5s, statement=5s.
# CABLE_DB_POOL=3
# CABLE_DB_CONNECT_TIMEOUT=5
# CABLE_DB_CHECKOUT_TIMEOUT=5
# CABLE_DB_STATEMENT_TIMEOUT=5000ms

# ── Production migrations / maintenance ─────────────────────
# Do NOT permanently disable statement_timeout for the web application.
# For a one-off long production migration, override it only for that command:
#   PRODUCTION_DB_STATEMENT_TIMEOUT=0 bin/rails db:migrate
# or only the primary DB:
#   PRIMARY_DB_STATEMENT_TIMEOUT=0 bin/rails db:migrate
#
# After the command exits, normal production timeout defaults apply again.

# ── Mailer ───────────────────────────────────────────────────
# From-address shown in outbound Devise emails.
# Update config/initializers/devise.rb → config.mailer_sender to match.
# DEVISE_MAILER_SENDER=noreply@your-domain.example.com

# SMTP delivery is enabled when SMTP_ADDRESS is set (used by
# config/initializers/action_mailer_smtp.rb).
# Local Mailpit: SMTP_ADDRESS=localhost SMTP_PORT=1025 (UI at http://localhost:8025)
# Containerized app → Mailpit on host: SMTP_ADDRESS=host.docker.internal
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=your-domain.example.com
# SMTP_AUTHENTICATION=plain

# Host used in confirmation/reset links generated by mailer templates.
# MAILER_HOST=your-domain.example.com

# ── Admin seed ───────────────────────────────────────────────
# Used by db/seeds.rb to create the initial admin account.
# Falls back to Rails.application.credentials.admin_email / admin_password.
# Values match the defaults in scripts/test_helpers.sh so the API test suites
# can sign in as the seeded admin.
ADMIN_EMAIL=admin@admin.admin
ADMIN_PASSWORD=adminAdmin@1

# Devise mailer sender address
DEVISE_MAILER_SENDER=noreply@example.com

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4000

# ── Application ──────────────────────────────────────────────
# Host and protocol used by mailer templates in production.
# APP_HOST=your-domain.example.com
# APP_PROTOCOL=https

# JWT token for manual scripts in manual/
TEST_JWT_TOKEN=
