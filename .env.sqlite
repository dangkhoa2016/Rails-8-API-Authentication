# Local development environment — DO NOT commit.
# Loaded by dotenv in development and test.

# ── Mailer (Mailpit) ───────────────────────────────────────
# Test emails locally with Mailpit:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
# Open http://localhost:8025 to view sent emails.
SMTP_ADDRESS=localhost
SMTP_PORT=1025
# Mailpit does not require SMTP authentication. Only set SMTP_AUTHENTICATION
# (and SMTP_USERNAME/SMTP_PASSWORD) when your SMTP provider requires it.
# If the Rails app runs inside Docker, point to the Mailpit container instead:
# SMTP_ADDRESS=host.docker.internal

# Host used in confirmation/reset links generated by mailer templates.
MAILER_HOST=localhost

# From-address shown in outbound Devise emails.
CORS_ALLOWED_ORIGINS="*"
DEVISE_MAILER_SENDER=noreply@example.com

# ── Admin seed ───────────────────────────────────────────────
# Used by db/seeds.rb to create the initial admin account.
# Falls back to Rails.application.credentials.admin_email / admin_password.
# Values match the defaults in scripts/test_helpers.sh so the API test suites
# can sign in as the seeded admin.
ADMIN_EMAIL=admin@admin.admin
ADMIN_PASSWORD=adminAdmin@1
